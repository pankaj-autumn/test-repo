{%- assign badges = product.metafields.custom.badges -%}

<style>
  .product-label {
    position: absolute;
    z-index: 2;
    padding: 10px;
     display: flex;         
    flex-direction: column; 
    gap: 5px;           
  }
  
  .position-top-left {
    top: 0;
    left: 0;
  }
  .position-top-right {
    top: 0;
    right: 0;
  }
  .position-bottom-left {
    bottom: 0;
    left: 0;
  }
  .position-bottom-right {
    bottom: 0;
    right: 0;
  }
</style>

{%- if badges != blank -%}


  <div class="product-label position-{{ custom_badge_position }}">
    {%- for badge in badges.value -%}
      {%- assign background_color = badge.color.value -%}
      {%- assign color_string = "" | append : background_color -%}
      {%- assign text_color = color_string | color_lighten: 100 -%}

    <small class="product-label__badge" style="background-color: {{ background_color }}; color: {{ text_color }}; border-radius: 5px; padding : 5px;">
      {{ badge.text.value }}
    </small>
    {%- endfor -%}
  </div>
{%- endif -%}