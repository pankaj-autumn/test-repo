{% comment %}
  Cart recommendations section.
  Expects to be rendered through the /recommendations/products endpoint,
  so that the global `recommendations` object is populated by Shopify.

  It shows up to `section.settings.limit` recommended products, and
  falls back to a manual collection if there are no recommendations.
{% endcomment %}

{%- if cart.item_count > 0 -%}
{% assign limit = section.settings.limit | default: 4 %}

{% if section.settings.heading != blank %}
  <h2 class="cart-recommendations-heading">
    {{ section.settings.heading }}
  </h2>
{% endif %}

{% assign products = recommendations.products | slice: 0, limit %}
{% if products == blank and section.settings.fallback_collection != blank %}
  {% assign fallback_collection = collections[section.settings.fallback_collection] %}
  {% if fallback_collection %}
    {% assign products = fallback_collection.products | slice: 0, limit %}
  {% endif %}
{% endif %}

{% if products != blank %}
  <div
    id="cart-recommendations-root"
    class="cart-recommendations-grid"
    data-section-id="{{ section.id }}"
    data-limit="{{ section.settings.limit | default: 4 }}"
    data-intent="{{ section.settings.intent | default: 'related' }}"
  >
    {% for product in products %}
      {% render 'card-product',
        card_product: product,
        show_vendor: section.settings.show_vendor,
        show_quick_add: true,
        section_id: section.id
      %}
    {% endfor %}
  </div>
{% else %}
  <p class="cart-recommendations-empty">
    {{ section.settings.fallback_heading | default: 'No recommendations available' }}
  </p>
{% endif %}

<style>
  .cart-recommendations-heading {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem;
    text-align: center;
  }

  .cart-recommendations-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    margin-bottom: 2rem;
  }

  .cart-recommendations-empty {
    text-align: center;
    margin: 1.5rem 0 2rem;
  }

  /* Dynamic CSS: Hide section when the cart becomes empty */
  body:has(cart-items.is-empty) .cart-recommendations-heading,
  body:has(cart-items.is-empty) #cart-recommendations-root,
  body:has(cart-items.is-empty) .cart-recommendations-empty {
    display: none !important;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    console.log('cart recommendations script start');
    const container = document.getElementById('cart-recommendations-root');
    if (!container) return;
    try {
      // Load cart JSON to get first product ID
      const cartResponse = await fetch('/cart.js');
      if (!cartResponse.ok) return;
      const cart = await cartResponse.json();
      if (!Array.isArray(cart.items) || cart.items.length === 0) return;
      const firstItem = cart.items[0];
      const productId = firstItem.product_id;

      const sectionId = container.dataset.sectionId;
      const limit = container.dataset.limit || 4;
      const intent = container.dataset.intent || 'related';
      console.log('Fetching recommendations', { sectionId, limit, intent, productId });

      const url = new URL(window.location.origin + '/recommendations/products');
      url.searchParams.set('intent', intent);
      url.searchParams.set('product_id', productId);
      url.searchParams.set('section_id', sectionId);
      url.searchParams.set('limit', limit);
      url.searchParams.set('format', 'json'); // Request JSON response

      const response = await fetch(url.toString());
      if (!response.ok) {
        const errorBody = await response.text();
        console.error('Shopify error', response.status, errorBody);
        return;
      }

      const data = await response.json();
      const products = data.products || [];
      if (!products.length) {
        console.warn('No recommendation products returned');
        return;
      }
      console.log('recommendations products', products, sectionId, data);
      for (const product of products) {
        const productHtml = `
          {% render 'card-product',
            card_product: product,
            show_vendor: false,
            show_quick_add: false,
            section_id: sectionId
          %}
        `;
        container.insertAdjacentHTML('beforeend', productHtml);
      }
      const cardsHtml = products
        .map((product) => {
          const imageUrl = product.featured_image || '';
          const price = product.price || '';
          const title = product.title || '';
          const productUrl = product.url || '#';

          return `
    <div class="product-card-wrapper">
      <div class="card">

        <a href="${productUrl}" class="full-unstyled-link">

          <img
            src="${imageUrl}"
            alt="${title}"
            class="product-card-image"
            loading="lazy"
            width="100"
            height="100"
          />

          <p class="product-card-title">
            ${title}
          </p>

          <p class="product-card-price">
            ${price}
          </p>

        </a>

      </div>
    </div>
  `;
        })
        .join('');

      container.innerHTML = cardsHtml;
    } catch (error) {
      console.error('Failed to load cart recommendations', error);
    }
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Cart recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "fallback_heading",
      "label": "Fallback heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "fallback_collection",
      "label": "Fallback collection (e.g., Best sellers)"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation intent",
      "options": [
        { "value": "related", "label": "Related" },
        { "value": "complementary", "label": "Complementary" }
      ],
      "default": "related"
    }
  ],
  "presets": [
    {
      "name": "Cart recommendations"
    }
  ]
}
{% endschema %}
