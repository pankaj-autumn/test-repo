{%- assign badges = product.metafields.custom.badges -%}

{%- if badges != blank -%}
    
{{console.log(badges)}}

  <div class="product-label">
    {%- assign background_color = badges.color -%}
    {%- assign color_string = "" | append : background_color -%}
    {%- assign text_color = color_string | color_lighten: 100 -%}
    
    <small class="product-label__badge" style="background-color: {{ background_color }}; color: {{ text_color }};">
      {{ badges }}
    </small>

    <span>{{ badges }}</span>
  </div>
{%- endif -%}